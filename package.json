{
  "name": "@earthranger/react-native-audio-form-fill",
  "version": "0.1.0",
  "description": "Offline, on-device dictation that fills JSON Schema forms using Whisper and llama.cpp",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./src/index.ts",
  "source": "./src/index.ts",
  "scripts": {
    "preinstall": "git config core.hooksPath .githooks",
    "prepare": "npm run build",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "lint": "eslint src/ test/ --ext .js,.jsx,.ts,.tsx",
    "test": "jest --coverage",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PADAS/react-native-audio-form-fill.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "react-native",
    "json-schema",
    "forms",
    "dictation",
    "speech-to-text",
    "whisper",
    "llama.cpp",
    "on-device",
    "offline",
    "earthranger"
  ],
  "author": "EarthRanger",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/PADAS/react-native-audio-form-fill/issues"
  },
  "homepage": "https://github.com/PADAS/react-native-audio-form-fill#readme",
  "jest": {
    "testMatch": [
      "<rootDir>/test/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts"
    ],
    "moduleNameMapper": {
      "^react-native-fs$": "<rootDir>/test/mocks/reactNativeFs.ts",
      "^whisper\\.rn$": "<rootDir>/test/mocks/whisperRn.ts",
      "^llama\\.rn$": "<rootDir>/test/mocks/llamaRn.ts",
      "^react-native-audio-api$": "<rootDir>/test/mocks/reactNativeAudioApi.ts"
    }
  },
  "peerDependencies": {
    "llama.rn": "^0.12.9",
    "react": ">=18",
    "react-native-audio-api": "^0.13.0",
    "react-native-fs": ">=2.18.0",
    "whisper.rn": "^0.7.4"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "llama.rn": "^0.12.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-native": "^0.79.6",
    "react-native-audio-api": "^0.13.0",
    "react-native-fs": "^2.20.0",
    "typescript": "^5.6.3",
    "whisper.rn": "^0.7.4"
  }
}
